# PipeOps MCP Server Configuration

# Authentication - Use either token or email/password
PIPEOPS_TOKEN=your-api-token-here

# OR use email/password authentication
# PIPEOPS_EMAIL=your-email@example.com
# PIPEOPS_PASSWORD=your-password

# Optional: Custom API base URL
# PIPEOPS_BASE_URL=https://api.pipeops.io
