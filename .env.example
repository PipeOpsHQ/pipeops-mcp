# PipeOps MCP Server Configuration

# Authentication - Use either token or email/password
PIPEOPS_TOKEN=your-api-token-here

# OR use email/password authentication
# PIPEOPS_EMAIL=your-email@example.com
# PIPEOPS_PASSWORD=your-password

# Optional: Custom API base URL
# PIPEOPS_BASE_URL=https://api.pipeops.io

# Hosted Streamable HTTP transport
# PIPEOPS_TRANSPORT=http
# PIPEOPS_HTTP_ADDR=:8080
# PIPEOPS_MCP_PUBLIC_URL=https://mcp.pipeops.app/mcp

# Hosted authentication: bearer (default), bridge, or external
# PIPEOPS_OAUTH_MODE=bridge
# SQLite is the default bridge store. Mount /data as a persistent volume.
# PIPEOPS_OAUTH_STORE=sqlite
# PIPEOPS_OAUTH_SQLITE_PATH=/home/nonroot/.pipeops-mcp/oauth/pipeops-mcp-oauth.db
# For a durable PVC (with fsGroup 65532): /data/oauth/pipeops-mcp-oauth.db
# For multiple MCP replicas, use Redis instead:
# PIPEOPS_OAUTH_STORE=redis
# PIPEOPS_OAUTH_REDIS_URL=rediss://user:password@redis.example.com:6379/0
# Generate with: openssl rand -base64 32
# PIPEOPS_OAUTH_ENCRYPTION_KEY=base64-encoded-32-byte-key
# PIPEOPS_OAUTH_ISSUER=https://mcp.pipeops.app
# PIPEOPS_MCP_SCOPES=api:read,api:write

# PostHog MCP Analytics (https://posthog.com/docs/mcp-analytics)
# Project: 15061 — set the project API key (phc_…), not the project id alone.
# POSTHOG_API_KEY=phc_xxxxxxxx
# POSTHOG_PROJECT_ID=15061
# POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_MCP_ANALYTICS=true
